#!/usr/bin/env bash
#
# mov2gif.sh — convert a .mov to a high-quality GIF using ffmpeg’s palette method
# macOS-compatible
#
# Usage:
#   ./mov2gif.sh input.mov [-o output.gif] [-f fps] [-w width]
#
# Options:
#   input.mov              Input .mov file (required, positional)
#   -o  Output .gif file   (default: same directory & base name as input)
#   -f  Frames per second  (default: $DEFAULT_FPS)
#   -w  Width in pixels    (auto-scaled height; default: $DEFAULT_WIDTH)
#   -h  Show this help message

set -euo pipefail

# Defaults
DEFAULT_FPS=30
DEFAULT_WIDTH=320

fps=$DEFAULT_FPS
width=$DEFAULT_WIDTH
output=""
input=""

usage() {
  cat <<EOF
Usage: $(basename "$0") input.mov [-o output.gif] [-f fps] [-w width]

Options:
  input.mov              Input .mov file (required, positional)
  -o  Output .gif file   (default: same directory & base name as input)
  -f  Frames per second  (default: $DEFAULT_FPS)
  -w  Width in pixels    (auto-scaled height; default: $DEFAULT_WIDTH)
  -h  Show this help message
EOF
}

# Parse optional flags
while getopts "o:f:w:h" opt; do
  case "$opt" in
    o) output="$OPTARG" ;;
    f) fps="$OPTARG" ;;
    w) width="$OPTARG" ;;
    h|*) usage; exit 0 ;;
  esac
done

# Shift to positional argument
shift $((OPTIND - 1))

# Get input.mov from position
input="${1:-}"

if [[ -z "$input" ]]; then
  echo "Error: input .mov file is required." >&2
  usage
  exit 1
fi

# Derive default output if not provided
if [[ -z "$output" ]]; then
  dir=$(dirname "$input")
  base=$(basename "$input")
  name="${base%.*}"
  output="$dir/$name.gif"
fi

# Create a temporary palette file (macOS-friendly)
palette=$(mktemp /tmp/palette.XXXXXX.png)
trap 'rm -f "$palette"' EXIT

echo "Generating palette for '$input' at ${fps} fps, width ${width}px…"
ffmpeg -v warning -i "$input" \
  -vf "fps=${fps},scale=${width}:-1:flags=lanczos,palettegen" \
  -frames:v 1 \
  -y "$palette"

echo "Creating GIF → '$output'…"
ffmpeg -v warning -i "$input" \
  -i "$palette" \
  -filter_complex "fps=${fps},scale=${width}:-1:flags=lanczos[x];[x][1:v]paletteuse" \
  -y "$output"

echo "✅ Done! GIF saved to $output"
